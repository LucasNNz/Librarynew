{
  "name": "corvo-core-v2",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply CORVO_DB --remote --config wrangler.jsonc",
    "typecheck:structural": "tsc -p tsconfig.validate.json --pretty false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260828.0",
    "typescript": "5.9.3",
    "wrangler": "4.33.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "^4.4.3"
  }
}
