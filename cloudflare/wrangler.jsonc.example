{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corvo-core-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corvo-library-v2",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "corvoquiz-prod"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MATERIALIZE_QUEUE",
        "queue": "corvo-materialize-v2"
      }
    ],
    "consumers": [
      {
        "queue": "corvo-materialize-v2",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "corvo-materialize-v2-dlq",
        "retry_delay": 5
      }
    ]
  }
}
